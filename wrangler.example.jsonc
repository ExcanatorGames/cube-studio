{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cube-studio",
  "main": "worker/cloudflare.js",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist/cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cube-studio",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": false
  }
}
